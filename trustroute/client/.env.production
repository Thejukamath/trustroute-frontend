# Production build (npm run build) — Vercel/any static host bakes these in.
# The deployed frontend talks to the Render-hosted backend directly.
VITE_API_URL=https://trustroute-backend.onrender.com

# x402 payer wallet — Algorand TestNet, USDC ASA 10458941.
# TestNet-only funds (worthless). The same payer signs every browser payment.
VITE_AVM_MNEMONIC=hard opinion dolphin found cave peanut end stage churn deputy front desert region slide false dirt exile jump parade memory priority margin grain above walnut
VITE_AVM_ADDRESS=6QB52JY4QVOYB724A5YXLIECLPDJHRFC2MHJDQWB57YNVTBAXPTTQVNGS4

# x402 facilitator (default when unset)
VITE_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Spend policy — enforced in the browser BEFORE signing any payment
VITE_DAILY_BUDGET=1.0
VITE_MAX_PER_REQUEST=0.1
VITE_ALLOWED_SERVICES=
VITE_BLOCKED_SERVICES=
VITE_REQUIRE_APPROVAL_ABOVE=0