# Copy to .env (or .env.production) and point at your deployed backend.
# Leave unset to use the local Vite dev proxy (http://localhost:4000 for /api).
VITE_API_URL=https://trustroute-backend.onrender.com

# ══ REAL x402 payments — Algorand TestNet · USDC (ASA 10458941) ═══════════════
# The client signs every micropayment in the browser. You need ONE signing key:
#
#   VITE_AVM_MNEMONIC     — 25-word TestNet payer mnemonic (recommended)
#   VITE_AVM_PRIVATE_KEY  — base64 64-byte key (seed + pubkey), alternative
#   VITE_AVM_ADDRESS      — payer address (informational; derived from the key)
#
# Generate a fresh payer pair with the SERVER package:
#   cd trustroute/server  &&  npm run setup-wallet
# then fund + opt in (see server/.env.example):
#   ALGO → https://lora.algokit.io/testnet/fund
#   USDC → https://faucet.circle.com/
# Opt-in: send a 0-amount USDC transfer to the account itself.
VITE_AVM_MNEMONIC=
VITE_AVM_PRIVATE_KEY=
VITE_AVM_ADDRESS=

# x402 facilitator (defaults to the goplausible facilitator when unset).
VITE_FACILITATOR_URL=https://facilitator.goplausible.xyz

# ══ Spend policy — enforced in the browser BEFORE signing any payment ════════
# Empty / 0 = permissive default shown below (demo-friendly). These are real
# guards: set them and the client will refuse over-budget payments.
VITE_DAILY_BUDGET=1.0            # max USD per rolling 24h (0 = unlimited)
VITE_MAX_PER_REQUEST=0.1         # max USD per single request (0 = unlimited)
VITE_ALLOWED_SERVICES=           # allowlist, e.g. weather,news (empty = all)
VITE_BLOCKED_SERVICES=           # denylist (empty = none)
VITE_REQUIRE_APPROVAL_ABOVE=0    # USD price above which the user must confirm